# Convex Setup
# Run `npx convex dev` to automatically populate these keys and create a Convex project
NEXT_PUBLIC_CONVEX_URL=https://your-convex-project-url.convex.cloud
CONVEX_DEPLOYMENT=dev:your-convex-deployment-name

# Clerk Authentication
# Get these from your Clerk Dashboard (https://dashboard.clerk.com/)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_JWT_ISSUER_DOMAIN="https://your-clerk-domain.clerk.accounts.dev"

# Google Generative AI (Gemini)
# Get from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key"

# Resend (Email Service)
# Get from Resend Dashboard (https://resend.com/)
RESEND_API_KEY="re_your_resend_api_key"

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
